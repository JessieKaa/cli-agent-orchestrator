# cao-ilink-webhook plugin configuration
#
# Copy this file to `.env` in the directory where you launch `cao-server` from
# (or any parent directory — python-dotenv walks upward from CWD), then fill in
# your values. Real shell environment variables override values set here.
#
# The WeChat iLink Webhook Service must already be running and authorized.
# See https://github.com/JessieKaa/wechat-ilink-webhook for setup.

# Required. Base URL of the running iLink Webhook Service.
CAO_ILINK_WEBHOOK_URL=http://127.0.0.1:8080

# Required. Bearer token for the iLink Webhook Service (its API_TOKEN).
CAO_ILINK_API_TOKEN=change-me

# Required. Target WeChat user ID (typically `xxx@im.wechat`). The user must
# have sent the bot at least one message so the service has a context_token.
CAO_ILINK_TO_USER_ID=

# Optional. Comma-separated list of terminal statuses that trigger a
# notification. Defaults to "idle,completed,error,waiting_user_answer".
#CAO_ILINK_NOTIFY_STATUSES=idle,completed,error,waiting_user_answer

# Optional. HTTP timeout (seconds) for webhook POSTs. Default: 5.0
#CAO_ILINK_TIMEOUT_SECONDS=5.0

# Optional. Explicit iLink context_token, forwarded as-is to /messages/send.
# If unset, the service looks up a cached token by to_user_id.
#CAO_ILINK_CONTEXT_TOKEN=
